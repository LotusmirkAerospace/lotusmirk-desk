{
  "name": "desk",
  "productName": "Desk",
  "desktopName": "dev.desk.companion",
  "version": "0.1.0",
  "private": true,
  "description": "Free desktop app that connects and health-checks local AI tools, and tries open-source packages in a sandbox.",
  "license": "MIT",
  "author": "Lotusmirk (https://lotusmirk.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LotusmirkAerospace/lotusmirk-desk.git"
  },
  "homepage": "https://github.com/LotusmirkAerospace/lotusmirk-desk",
  "bugs": {
    "url": "https://github.com/LotusmirkAerospace/lotusmirk-desk/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "vitest run tests/live",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^44.11.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  }
}
