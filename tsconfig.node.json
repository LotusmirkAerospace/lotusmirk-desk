{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/adapters/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node", "node"]
  }
}
